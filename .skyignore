# SkyPilot uses this file instead of .gitignore when it syncs the workdir to a
# cluster. The GPU confirmation runs (cloud/gpu-baselines.yaml) only need src/,
# benchmarks/ (runners, manifests and their script lockfiles) and scripts/.
# Results are written on the cluster and copied back by scripts/sky_gpu.sh.
.git/
.github/
.venv/
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
results/
paper/
slides/
presentation_files/
presentation-proposal_files/
notebooks/
docs/
examples/
tests/
dist/
IraitzJos.tex
